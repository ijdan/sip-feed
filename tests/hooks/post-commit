#!/bin/bash
# Hook post-commit — lance les tests fonctionnels automatiquement

ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║  🧪 Tests fonctionnels post-commit       ║"
echo "╚══════════════════════════════════════════╝"
echo ""

bash "$ROOT/tests/run-tests.sh"
